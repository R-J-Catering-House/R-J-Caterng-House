DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:3000,https://YOUR_VERCEL_DOMAIN.vercel.app
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.com
OWNER1_EMAIL=owner1@your-domain.com
OWNER1_PASSWORD=replace-with-a-strong-password
OWNER2_EMAIL=owner2@your-domain.com
OWNER2_PASSWORD=replace-with-a-strong-password
COOKIE_SECURE=true
